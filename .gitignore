# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# PyTorch / Ultralytics models and checkpoints
*.pt
*.pth
*.onnx
*.engine
models/*.pth
models/*.pt
!models/.gitkeep

# Dataset directories (prevent accidental commit of gigabytes of raw images)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
dataset/
samples/

# Results, output videos and database files
results/*.csv
results/*.json
results/*.png
results/*.mp4
results/*.avi
results/*.db
results/*.sqlite3
!results/.gitkeep
runs/

# Streamlit
.streamlit/secrets.toml

# Environment variables
.env
.env.local

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
