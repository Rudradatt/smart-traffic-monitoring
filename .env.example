# Hardware Device Configuration (auto, cuda, cpu)
DEVICE=auto

# Database Path
DATABASE_PATH=results/traffic_system.db

# Default YOLO Model for Detection & Tracking
DEFAULT_YOLO_MODEL=yolov8n.pt

# Reproducibility Seed
RANDOM_SEED=42

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_THEME_BASE=dark
